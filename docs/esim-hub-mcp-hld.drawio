<mxfile host="app.diagrams.net" type="device">
  <diagram id="esim-hub-mcp-hld" name="eSIM Hub MCP — HLD">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="&lt;b&gt;eSIM Hub MCP Server — High-Level Design&lt;/b&gt;" style="text;html=1;fontSize=20;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="-20" width="600" height="40" as="geometry" />
        </mxCell>

        <!-- ============ LEFT: USER SIDE ============ -->
        <mxCell id="actorUser" value="End User" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" vertex="1" parent="1">
          <mxGeometry x="135" y="50" width="40" height="70" as="geometry" />
        </mxCell>

        <mxCell id="claudeBox" value="&lt;b&gt;Claude Desktop / claude.ai&lt;/b&gt;&lt;br&gt;MCP client (custom connector)&lt;br&gt;Advanced settings:&lt;br&gt;Client ID = any · Client Secret = mm-hub API key" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="230" height="110" as="geometry" />
        </mxCell>

        <mxCell id="browserBox" value="&lt;b&gt;User&#39;s Browser&lt;/b&gt;&lt;br&gt;opens short payment link,&lt;br&gt;pays on Stripe Checkout" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="430" width="230" height="90" as="geometry" />
        </mxCell>

        <mxCell id="inboxBox" value="&lt;b&gt;User&#39;s Email Inbox&lt;/b&gt;&lt;br&gt;activation QR code +&lt;br&gt;LPA activation URL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="880" width="230" height="90" as="geometry" />
        </mxCell>

        <!-- ============ MIDDLE: MCP SERVER ============ -->
        <mxCell id="serverContainer" value="eSIM Hub MCP Server — FastMCP (Python) · deployed on Render" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6C8EBF;verticalAlign=top;fontSize=14;fontStyle=1;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="360" y="30" width="640" height="840" as="geometry" />
        </mxCell>

        <mxCell id="mcpBox" value="&lt;b&gt;MCP Transport&lt;/b&gt;&lt;br&gt;POST /mcp (streamable HTTP)&lt;br&gt;Bearer token = mm-hub API key&lt;br&gt;(pass-through; mm hub is the&lt;br&gt;real gatekeeper)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="390" y="100" width="280" height="160" as="geometry" />
        </mxCell>

        <mxCell id="oauthBox" value="&lt;b&gt;OAuth 2.1 Authorization Server&lt;/b&gt;&lt;br&gt;EsimHubOAuthProvider (pass-through)&lt;br&gt;/.well-known metadata · /authorize&lt;br&gt;(auto-approve, PKCE) · /token&lt;br&gt;access token = Client Secret&lt;br&gt;= user&#39;s mm-hub API key" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="700" y="100" width="270" height="160" as="geometry" />
        </mxCell>

        <mxCell id="toolsBox" value="&lt;b&gt;MCP Tools&lt;/b&gt;&lt;br&gt;• get_all_bundles&lt;br&gt;• search_bundles&lt;br&gt;• create_payment_link&lt;br&gt;• purchase_bundle_and_send_activation&lt;br&gt;• send_activation_url_via_email&lt;br&gt;• get_order_history&lt;br&gt;+ prompt: user_journey&lt;br&gt;+ resource: greeting" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;spacingLeft=10;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="390" y="300" width="280" height="220" as="geometry" />
        </mxCell>

        <mxCell id="stripeSvcBox" value="&lt;b&gt;services/stripe_service&lt;/b&gt;&lt;br&gt;• create Checkout Session&lt;br&gt;(server-side price + metadata)&lt;br&gt;• verify payment_status == paid&lt;br&gt;• stamp order id on PaymentIntent&lt;br&gt;(one payment = one order)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="700" y="300" width="270" height="160" as="geometry" />
        </mxCell>

        <mxCell id="routesBox" value="&lt;b&gt;HTTP Routes&lt;/b&gt;&lt;br&gt;• GET / (health)&lt;br&gt;• GET /pay/{session_id} → 302 Stripe&lt;br&gt;• GET /payment/success · /cancel&lt;br&gt;• POST /payment/webhook&lt;br&gt;(signature-verified)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="390" y="560" width="280" height="180" as="geometry" />
        </mxCell>

        <mxCell id="hubSvcBox" value="&lt;b&gt;services/EsimHubService&lt;/b&gt;&lt;br&gt;• catalog: get-all / search / get-by-code&lt;br&gt;• create reseller order&lt;br&gt;• activation code · order history" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="700" y="500" width="270" height="150" as="geometry" />
        </mxCell>

        <mxCell id="utilsBox" value="&lt;b&gt;config/utils&lt;/b&gt;&lt;br&gt;• QR code generator&lt;br&gt;• SMTP email sender&lt;br&gt;• get_token (bearer pass-through)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="700" y="690" width="270" height="120" as="geometry" />
        </mxCell>

        <!-- ============ RIGHT: EXTERNAL SYSTEMS ============ -->
        <mxCell id="legendBox" value="&lt;b&gt;Key design points&lt;/b&gt;&lt;br&gt;• Multi-tenant pass-through auth: the OAuth Client Secret a user types IS their mm-hub API key; no keys stored server-side&lt;br&gt;• Payment-first: reseller order is created only after the Stripe session is paid&lt;br&gt;• Bundle + email are read from the paid session&#39;s metadata (order always matches payment)&lt;br&gt;• Short /pay links avoid truncated Stripe URLs in chat" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;spacingLeft=10;spacingRight=6;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1120" y="50" width="300" height="250" as="geometry" />
        </mxCell>

        <mxCell id="stripeExt" value="&lt;b&gt;Stripe&lt;/b&gt;&lt;br&gt;• Checkout Sessions (hosted payment page)&lt;br&gt;• PaymentIntents (fulfillment stamp)&lt;br&gt;• Webhook: checkout.session.completed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6E5FF;strokeColor=#635BFF;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1120" y="380" width="300" height="170" as="geometry" />
        </mxCell>

        <mxCell id="hubExt" value="&lt;b&gt;eSIM Hub Platform (Monty)&lt;/b&gt;&lt;br&gt;• Digital Services API — catalog&lt;br&gt;• MM Hub API — orders, activation codes,&lt;br&gt;order history&lt;br&gt;Auth: Api-Key + Tenant headers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1120" y="600" width="300" height="170" as="geometry" />
        </mxCell>

        <mxCell id="smtpExt" value="&lt;b&gt;SMTP Relay (Gmail)&lt;/b&gt;&lt;br&gt;outbound activation emails" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1120" y="820" width="300" height="90" as="geometry" />
        </mxCell>

        <!-- ============ EDGES ============ -->
        <mxCell id="e1" value="1. &quot;I need an eSIM for France&quot;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;" edge="1" parent="1" source="actorUser" target="claudeBox">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e2" value="2. OAuth connect (DCR disabled,&#10;secret carried through)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="claudeBox" target="oauthBox">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="155" y="70" />
              <mxPoint x="835" y="70" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="e3" value="3. MCP tool calls&#10;(Bearer = mm-hub API key)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="claudeBox" target="mcpBox">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="eDispatch" value="dispatch" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="mcpBox" target="toolsBox">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="eToolsStripeSvc" value="uses" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="toolsBox" target="stripeSvcBox">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="eToolsHubSvc" value="uses" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="toolsBox" target="hubSvcBox">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="eToolsUtils" value="uses" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;exitX=1;exitY=0.9;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="toolsBox" target="utilsBox">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="685" y="498" />
              <mxPoint x="685" y="750" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="eStripeSvcExt" value="5. create Checkout Session&#10;9a. verify paid + stamp order id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="stripeSvcBox" target="stripeExt">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="eHubSvcExt" value="4. search catalog / get-by-code&#10;9b. create order + activation code" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="hubSvcBox" target="hubExt">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="eBrowserRoutes" value="6. GET /pay/{session_id}&#10;(short chat-safe link)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="browserBox" target="routesBox">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="330" y="475" />
              <mxPoint x="330" y="605" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="eBrowserStripe" value="7. 302 → Stripe Checkout · user pays" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;dashed=1;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.9;entryDx=0;entryDy=0;" edge="1" parent="1" source="browserBox" target="stripeExt">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="97" y="845" />
              <mxPoint x="1060" y="845" />
              <mxPoint x="1060" y="533" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="eWebhook" value="8. webhook: checkout.session.completed&#10;(Stripe-Signature verified)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;dashed=1;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="stripeExt" target="routesBox">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1030" y="507" />
              <mxPoint x="1030" y="858" />
              <mxPoint x="530" y="858" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="eUtilsSmtp" value="10. activation email + QR" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="utilsBox" target="smtpExt">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="eSmtpInbox" value="deliver activation QR + LPA URL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="smtpExt" target="inboxBox">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1270" y="1000" />
              <mxPoint x="155" y="1000" />
            </Array>
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
